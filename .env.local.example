# ── Supabase ──────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Polymarket execution (get from app.polymarket.com/settings) ─
POLY_API_KEY=your-api-key
POLY_API_SECRET=your-api-secret
POLY_API_PASSPHRASE=your-passphrase

# ── Telegram ──────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# ── Security ──────────────────────────────────────────────────
# Protects POST /api/markets and POST /api/signals
SCRAPE_SECRET=generate-a-random-string-here

# Protects POST /api/orders and DELETE /api/orders (kill switch)
# Leave unset in dev to disable execution entirely
EXECUTION_SECRET=generate-a-different-random-string

# Protects GET /api/cron when called manually (not by Vercel)
CRON_SECRET=generate-another-random-string

# ── Optional: Fed model fallback ──────────────────────────────
# If CME FedWatch scrape fails, use these manual values
FED_CUT_PROB_NEXT=0.72
FED_NEXT_MEETING=2025-09
